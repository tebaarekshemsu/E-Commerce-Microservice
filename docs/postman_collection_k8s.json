{
  "info": {
    "name": "E-Commerce Microservices (Kubernetes via Broker)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_broker", "value": "http://localhost:9090" },
    { "key": "auth_token", "value": "" },
    { "key": "rabbit_host", "value": "http://localhost:15672" },
    { "key": "rabbit_user", "value": "guest" },
    { "key": "rabbit_pass", "value": "guest" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Broker health",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/ping", "host": ["{{base_broker}}"], "path": ["ping"] } }
        },
        {
          "name": "gRPC health",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/grpc/health", "host": ["{{base_broker}}"], "path": ["grpc", "health"] } }
        },
        {
          "name": "Order health (proxy)",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/order-service/order-service/health", "host": ["{{base_broker}}"], "path": ["order-service", "order-service", "health"] } }
        },
        {
          "name": "Product ping (proxy)",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/product-service/ping", "host": ["{{base_broker}}"], "path": ["product-service", "ping"] } }
        }
      ]
    },
    {
      "name": "User Service via Broker",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_broker}}/user-service/api/auth/register/", "host": ["{{base_broker}}"], "path": ["user-service", "api", "auth", "register", ""] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"username\": \"user1\",\n  \"password\": \"Password123!\",\n  \"confirm_password\": \"Password123!\"\n}" }
          }
        },
        {
          "name": "Login (JWT token)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_broker}}/user-service/api/token/", "host": ["{{base_broker}}"], "path": ["user-service", "api", "token", ""] },
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"Password123!\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.access) { pm.collectionVariables.set('auth_token', data.access); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile (me)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "url": { "raw": "{{base_broker}}/user-service/api/auth/profile/", "host": ["{{base_broker}}"], "path": ["user-service", "api", "auth", "profile", ""] }
          }
        }
      ]
    },
    {
      "name": "Product Service via Broker",
      "item": [
        {
          "name": "List products (proxy)",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/product-service/api/products", "host": ["{{base_broker}}"], "path": ["product-service", "api", "products"] } }
        },
        {
          "name": "Create product (proxy)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
            "url": { "raw": "{{base_broker}}/product-service/api/products", "host": ["{{base_broker}}"], "path": ["product-service", "api", "products"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sample Product\",\n  \"description\": \"Via broker\",\n  \"price\": 19.99,\n  \"category_id\": 1\n}" }
          }
        },
        {
          "name": "gRPC: get product",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/grpc/product/1", "host": ["{{base_broker}}"], "path": ["grpc", "product", "1"] } }
        },
        {
          "name": "gRPC: check availability",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/grpc/product/1/availability?quantity=1", "host": ["{{base_broker}}"], "path": ["grpc", "product", "1", "availability"], "query": [ { "key": "quantity", "value": "1" } ] } }
        }
      ]
    },
    {
      "name": "Order Service via Broker",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/order-service/health", "host": ["{{base_broker}}"], "path": ["order-service", "health"] } }
        },
        {
          "name": "List orders",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/order-service/api/orders", "host": ["{{base_broker}}"], "path": ["order-service", "api", "orders"] } }
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_broker}}/order-service/api/orders", "host": ["{{base_broker}}"], "path": ["order-service", "api", "orders"] },
            "body": { "mode": "raw", "raw": "{\n  \"orderDate\": \"2025-01-01\",\n  \"orderDesc\": \"Sample order\",\n  \"orderFee\": 10.5,\n  \"cart\": { \"cartId\": 1 }\n}" }
          }
        },
        {
          "name": "List carts",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/order-service/api/carts", "host": ["{{base_broker}}"], "path": ["order-service", "api", "carts"] } }
        },
        {
          "name": "Create cart",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_broker}}/order-service/api/carts", "host": ["{{base_broker}}"], "path": ["order-service", "api", "carts"] },
            "body": { "mode": "raw", "raw": "{\n  \"userId\": 1\n}" }
          }
        }
      ]
    },
    {
      "name": "Payment via Broker",
      "item": [
        {
          "name": "gRPC: process payment",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_broker}}/grpc/payment", "host": ["{{base_broker}}"], "path": ["grpc", "payment"] },
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"1\",\n  \"amount\": 10.5,\n  \"currency\": \"USD\",\n  \"payment_method\": \"card\"\n}" }
          }
        },
        {
          "name": "Payment ping (proxy)",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/payment-service/ping", "host": ["{{base_broker}}"], "path": ["payment-service", "ping"] } }
        }
      ]
    },
    {
      "name": "Notification",
      "item": [
        {
          "name": "Notification ping (proxy)",
          "request": { "method": "GET", "url": { "raw": "{{base_broker}}/notification-service/ping", "host": ["{{base_broker}}"], "path": ["notification-service", "ping"] } }
        }
      ]
    },
    {
      "name": "RabbitMQ",
      "item": [
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "url": { "raw": "{{rabbit_host}}/api/overview", "host": ["{{rabbit_host}}"], "path": ["api", "overview"] },
            "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{rabbit_user}}", "type": "string" }, { "key": "password", "value": "{{rabbit_pass}}", "type": "string" } ] }
          }
        },
        {
          "name": "Queues",
          "request": {
            "method": "GET",
            "url": { "raw": "{{rabbit_host}}/api/queues", "host": ["{{rabbit_host}}"], "path": ["api", "queues"] },
            "auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{rabbit_user}}", "type": "string" }, { "key": "password", "value": "{{rabbit_pass}}", "type": "string" } ] }
          }
        }
      ]
    }
  ]
}
